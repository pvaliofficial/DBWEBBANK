# ==============  لایه API (فقط این بخش اضافه شد)  ===========
# ============================================================
# این بخش هیچ تغییری در کد بالا ایجاد نمی‌کند.
# فقط یک وب‌سرور FastAPI راه‌اندازی می‌کند که از همان توابع
# clean_duplicate_data و create_*_pdf استفاده می‌کند.

API_TOKEN = "change-me-to-a-long-random-string"   # ← این را عوض کن
NGROK_TOKEN = "3KCSoQEysgizp6hvNQn3BnSkiqe_2zgUMDJMydxz4Rt6tpDjR"              # ← توکن ngrok خودت

_api_conns = {}   # اتصال‌های DuckDB مخصوص API

def _api_open_conn(bank):
    """باز کردن (یا برگرداندن) اتصال DuckDB برای یک بانک"""
    if bank in _api_conns:
        return _api_conns[bank]
    if bank not in bank_databases:
        raise HTTPException(400, f"بانک پشتیبانی نمی‌شود: {bank}")
    file_info = bank_databases[bank]
    if not os.path.exists(file_info["file"]):
        download_file(file_info["id"], file_info["file"])
    _api_conns[bank] = duckdb.connect(database=file_info["file"], read_only=True)
    return _api_conns[bank]

def _api_check_token(x_api_key):
    if x_api_key != API_TOKEN:
        raise HTTPException(status_code=401, detail="unauthorized")

def _api_build_query(bank, payload):
    """
    همان منطق on_search_clicked، ولی بر اساس dict ورودی.
    خروجی: (query, search_params)
    """
    conditions = []
    search_params = []

    name = payload.get("name")
    birth_date = payload.get("birth_date")
    mobile = payload.get("mobile")
    national_code = payload.get("national_code")
    card_no = payload.get("card_no")
    father_name = payload.get("father_name")
    city = payload.get("city")

    if bank == "ملی":
        other_fields_filled = any([name, mobile, national_code, card_no])

        if name:
            conditions.append(f"FULL_NAME LIKE '%{name}%'")
            search_params.append(f"نام: {name}")

        if birth_date:
            if len(birth_date) == 4 and birth_date.isdigit() and other_fields_filled:
                conditions.append(f"BIRTH_DATE LIKE '{birth_date}%'")
                search_params.append(f"سال تولد: {birth_date}")
            else:
                conditions.append(f"BIRTH_DATE LIKE '%{birth_date}%'")
                search_params.append(f"تاریخ تولد: {birth_date}")

        if mobile:
            conditions.append(f"MOBILE LIKE '%{mobile}%'")
            search_params.append(f"موبایل: {mobile}")

        if national_code:
            if len(national_code) == 3 and national_code.isdigit() and other_fields_filled:
                conditions.append(f"NATIONAL_CODE LIKE '{national_code}%'")
                search_params.append(f"سه رقم اول کدملی: {national_code}")
            else:
                conditions.append(f"NATIONAL_CODE LIKE '%{national_code}%'")
                search_params.append(f"کدملی: {national_code}")

        if card_no:
            conditions.append(f"CARD_NO LIKE '%{card_no}%'")
            search_params.append(f"کارت: {card_no}")

        table = "Melli"

    elif bank == "ملت":
        other_fields_filled = any([name, mobile, father_name, city, national_code, card_no])

        if name:
            conditions.append(f"FULL_NAME LIKE '%{name}%'")
            search_params.append(f"نام: {name}")

        if birth_date:
            if len(birth_date) == 4 and birth_date.isdigit() and other_fields_filled:
                conditions.append(f"BIRTH_DATE LIKE '{birth_date}%'")
                search_params.append(f"سال تولد: {birth_date}")
            else:
                conditions.append(f"BIRTH_DATE LIKE '%{birth_date}%'")
                search_params.append(f"تاریخ تولد: {birth_date}")

        if mobile:
            conditions.append(f"MOBILE LIKE '%{mobile}%'")
            search_params.append(f"موبایل: {mobile}")

        if father_name:
            conditions.append(f"FATHER_NAME LIKE '%{father_name}%'")
            search_params.append(f"نام پدر: {father_name}")

        if city:
            conditions.append(f"(CITY_NAME LIKE '%{city}%' OR PROVINCE_NAME LIKE '%{city}%' OR BIRTH_CITY LIKE '%{city}%' OR BIRTH_PROVINCE LIKE '%{city}%' OR ADDRESS LIKE '%{city}%')")
            search_params.append(f"شهر/استان: {city}")

        if national_code:
            if len(national_code) == 3 and national_code.isdigit() and other_fields_filled:
                conditions.append(f"NATIONAL_CODE LIKE '{national_code}%'")
                search_params.append(f"سه رقم اول کدملی: {national_code}")
            else:
                conditions.append(f"NATIONAL_CODE LIKE '%{national_code}%'")
                search_params.append(f"کدملی: {national_code}")

        if card_no:
            conditions.append(f"CARD_NO LIKE '%{card_no}%'")
            search_params.append(f"کارت: {card_no}")

        table = "Mellat"

    else:  # صادرات
        if name:
            conditions.append(f"FullName LIKE '%{name}%'")
            search_params.append(f"نام: {name}")
        if mobile:
            conditions.append(f"user_phone_number LIKE '%{mobile}%'")
            search_params.append(f"موبایل: {mobile}")

        table = "Saderat"

    if not conditions:
        raise HTTPException(400, "حداقل یک فیلتر باید پر شود")

    query = f"SELECT * FROM {table} WHERE " + " AND ".join(conditions)
    return query, search_params

def _api_do_search(bank, payload):
    """اجرای جستجو و برگرداندن (result_df, search_params)"""
    conn = _api_open_conn(bank)
    query, search_params = _api_build_query(bank, payload)

    try:
        df = conn.execute(query).fetchdf()
    except Exception as e:
        raise HTTPException(500, f"خطا در اجرای کوئری: {e}")

    return df, search_params

# ---------- FastAPI app ----------
api_app = FastAPI(title="Bank Search API", version="1.0")

@api_app.get("/health")
def api_health():
    return {"ok": True, "banks": list(bank_databases.keys())}

@api_app.get("/search")
def api_search_get(
    bank: str = Query(..., description="ملی / ملت / صادرات"),
    name: str | None = None,
    birth_date: str | None = None,
    mobile: str | None = None,
    father_name: str | None = None,
    city: str | None = None,
    national_code: str | None = None,
    card_no: str | None = None,
    limit: int = 50,
    x_api_key: str | None = Header(default=None),
):
    """جستجو به روش GET"""
    _api_check_token(x_api_key)

    payload = {
        "name": name, "birth_date": birth_date, "mobile": mobile,
        "father_name": father_name, "city": city,
        "national_code": national_code, "card_no": card_no,
    }

    df, search_params = _api_do_search(bank, payload)

    if df.empty:
        return JSONResponse({
            "count": 0, "truncated": False,
            "search_params": search_params,
            "columns": [], "rows": [],
        })

    # همان پاک‌سازی که در UI استفاده می‌شود
    cleaned = clean_duplicate_data(df, bank)

    truncated = len(cleaned) > limit
    cleaned = cleaned.head(limit).fillna("None")

    return JSONResponse({
        "count": len(cleaned),
        "truncated": truncated,
        "search_params": search_params,
        "columns": list(cleaned.columns),
        "rows": cleaned.to_dict(orient="records"),
    })

@api_app.post("/search")
def api_search_post(
    body: dict = Body(...),
    x_api_key: str | None = Header(default=None),
):
    """جستجو به روش POST
    بدنه JSON نمونه:
    {
      "bank": "ملی",
      "name": "علی",
      "mobile": "0912...",
      "limit": 50
    }
    """
    _api_check_token(x_api_key)

    bank = body.get("bank")
    if not bank:
        raise HTTPException(400, "فیلد 'bank' الزامی است")

    payload = {
        "name": body.get("name"),
        "birth_date": body.get("birth_date"),
        "mobile": body.get("mobile"),
        "father_name": body.get("father_name"),
        "city": body.get("city"),
        "national_code": body.get("national_code"),
        "card_no": body.get("card_no"),
    }
    limit = int(body.get("limit", 50))

    df, search_params = _api_do_search(bank, payload)

    if df.empty:
        return JSONResponse({
            "count": 0, "truncated": False,
            "search_params": search_params,
            "columns": [], "rows": [],
        })

    cleaned = clean_duplicate_data(df, bank)
    truncated = len(cleaned) > limit
    cleaned = cleaned.head(limit).fillna("None")

    return JSONResponse({
        "count": len(cleaned),
        "truncated": truncated,
        "search_params": search_params,
        "columns": list(cleaned.columns),
        "rows": cleaned.to_dict(orient="records"),
    })

@api_app.get("/report")
def api_report_get(
    bank: str = Query(...),
    name: str | None = None,
    birth_date: str | None = None,
    mobile: str | None = None,
    father_name: str | None = None,
    city: str | None = None,
    national_code: str | None = None,
    card_no: str | None = None,
    x_api_key: str | None = Header(default=None),
):
    """تولید PDF با همان توابع create_*_pdf"""
    _api_check_token(x_api_key)

    payload = {
        "name": name, "birth_date": birth_date, "mobile": mobile,
        "father_name": father_name, "city": city,
        "national_code": national_code, "card_no": card_no,
    }

    df, search_params = _api_do_search(bank, payload)
    if df.empty:
        raise HTTPException(404, "نتیجه‌ای یافت نشد")

    if bank == "ملی":
        pdf_data = create_melli_pdf(df, search_params)
    elif bank == "ملت":
        pdf_data = create_mellat_pdf(df, search_params)
    else:
        pdf_data = create_saderat_pdf(df, search_params)

    return Response(
        content=pdf_data,
        media_type="application/pdf",
        headers={"Content-Disposition": f'attachment; filename="results_{bank}.pdf"'},
    )

